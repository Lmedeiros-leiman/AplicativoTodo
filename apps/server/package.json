{
  "name": "@multitodo/server",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@multitodo/todo-application": "^1.0.0",
    "@multitodo/todo-contracts-layer": "^1.0.0",
    "@multitodo/todo-domain": "^1.0.0",
    "@multitodo/todo-infra": "^1.0.0",
    "@trpc/server": "^11.0.0",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.7",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3"
  }
}
